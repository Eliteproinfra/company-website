# SMTP credentials for the Contact / Enquiry / Career forms (app/api/enquiry, app/api/career-application).
# Copy this file to .env.local and fill in real values — .env.local is gitignored, never commit real credentials.
#
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@eliteproinfra.com,
#   SMTP_PASS=<16-character App Password, not your normal login password — generate one at
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification to be enabled).
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_USER=you@eliteproinfra.com,
#   SMTP_PASS=<your account password, or an app password if MFA is enforced>.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=marketing@eliteproinfra.com
SMTP_PASS=
# Where form submissions are delivered. Defaults to SMTP_USER if unset.
SMTP_TO=info@eliteproinfra.com
