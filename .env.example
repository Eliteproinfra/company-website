# SMTP credentials for the Contact / Enquiry / Career forms (app/api/enquiry, app/api/career-application).
# Copy this file to .env.local and fill in real values — .env.local is gitignored, never commit real credentials.
#
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@eliteproinfra.com,
#   SMTP_PASS=<16-character App Password, not your normal login password — generate one at
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification to be enabled).
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_USER=you@eliteproinfra.com,
#   SMTP_PASS=<your account password, or an app password if MFA is enforced>.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@eliteproinfra.com
# The variable is SMTP_PASS, not SMTP_PASSWORD — lib/mailer.ts, scripts/verify-smtp.sh and
# the AWS parameter /elitepro-website/prod/SMTP_PASS all use that name, and a mismatched one
# reads as unset, so every form fails with "Could not send your enquiry".
SMTP_PASS=
# Where form submissions are delivered. Defaults to SMTP_USER if unset.
SMTP_TO=info@eliteproinfra.com


# ---------------------------------------------------------------------------
# Instagram — latest 3 reels on the home page (lib/instagram.ts).
#
# Uses the official "Instagram API with Instagram Login" (graph.instagram.com).
# The old Basic Display API was shut down by Meta in December 2024 and must not
# be used. Nothing is scraped from instagram.com.
#
# One-time setup on the Instagram/Meta side:
#   1. The @eliteproinfra account must be a *professional* account
#      (Instagram app > Settings > Account type > switch to Business or Creator).
#   2. developers.facebook.com > My Apps > Create app > use case "Other" >
#      type "Business" > add the "Instagram" product.
#   3. Instagram > API setup with Instagram login > "Add account" and log in as
#      @eliteproinfra. Permission needed: instagram_business_basic (read-only —
#      it cannot post, comment, or DM).
#   4. On the same screen, "Generate token" gives a 60-day long-lived token.
#      Paste it below. The Instagram User ID shown there is optional (see below).
#   5. The app can stay in Development mode as long as @eliteproinfra is listed
#      as a role/tester on it; only tokens for connected accounts are needed.
#
# The token EXPIRES AFTER 60 DAYS. Refresh it before then with:
#   npm run instagram:token
# and paste the new value here (and into the server's .env.local / PM2 env).
# Set a calendar reminder — when it lapses the section falls back to a plain
# "Follow us on Instagram" panel, it does not break the page.

# Long-lived Instagram access token. REQUIRED — without it the section renders
# its fallback panel. Server-side only: no NEXT_PUBLIC_ prefix, so Next.js can
# never inline it into the browser bundle.
INSTAGRAM_ACCESS_TOKEN=

# Optional. Defaults to "me", which resolves to whichever account the token
# belongs to — correct for the setup above. Only set this to a numeric
# Instagram User ID if one token serves several accounts.
INSTAGRAM_USER_ID=

# Optional. Seconds between Instagram API calls; the cards are served from the
# Next.js data cache in between. The code default is 3600 (1 hour); this is set
# to 120 so a newly posted reel shows up within about two minutes.
#
# 120s = 30 calls/hour, comfortably inside the Instagram Login limit of 200
# calls/hour per user. Do not go much below this — at 30s you are at 120/hour
# and one extra deploy or crawler can tip the app into a rate limit.
#
# ONLY has an effect on the Node-server deployment (`next start` via PM2 — see
# deploy/README.md). In the static export from scripts/export.sh there is no
# server to revalidate: the reels are frozen into the HTML at build time and
# only change when you rebuild and re-upload out/.
INSTAGRAM_REVALIDATE_SECONDS=120

# Optional. Defaults to https://graph.instagram.com/v23.0. Change it to bump the
# API version, or to https://graph.facebook.com/v23.0 if the account is wired up
# through the Facebook-Login flavour of the API instead (that route additionally
# needs a linked Facebook Page, and INSTAGRAM_USER_ID set to the IG User ID).
INSTAGRAM_API_BASE=

# ---------------------------------------------------------------------------
# Admin CMS database (MySQL)
# ---------------------------------------------------------------------------
# Required for /admin and for any page reading content from the database.
# On Hostinger these come from hPanel -> Databases -> Management.
#
# IMPORTANT: do not reuse the credentials from the old PHP site. That host was
# compromised by a file-upload webshell, so its DB user and password must be
# treated as stolen — create a fresh database user instead.
#
# First-time setup:
#   npm run db:setup     # creates tables + prints a generated admin password ONCE
#   npm run db:seed      # imports the existing lib/data content into MySQL
#   npm run db:passwd -- --user admin   # rotate a password, revoking live sessions
#
# To try it locally without touching production, run MySQL in Docker. The
# docker-compose.yml at the repo root reads the DB_* values below, so fill them
# in first (DB_HOST=127.0.0.1, DB_PORT=3307, and any user/password/name you
# like), then:
#   docker volume create elite-web-mysql-data   # once, on a fresh machine
#   npm run db:up        # starts MySQL on 127.0.0.1:3307 and waits for it
#   npm run db:setup     # then the schema/seed steps above
# Docker Desktop has to be running, or every page that reads the database
# answers "Database unavailable".
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Connections held open per Node process. 10 is plenty for a single VPS.
DB_POOL_SIZE=10
